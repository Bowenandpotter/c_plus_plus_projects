{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "C++: clang++ build and run active file",
			"type": "shell",
			"command": "clang++ -std=c++17 -Wall -Wextra -pedantic \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
			"problemMatcher": "$gcc",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}